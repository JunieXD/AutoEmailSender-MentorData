{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoemailsender.example/schemas/organization-review.schema.json",
  "title": "Batch organization review manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "issue",
    "proposal_directory",
    "generated_at",
    "registry_sha256",
    "groups",
    "invalid_rows",
    "organizations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "batch_organization_review" },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 500 }
      }
    },
    "proposal_directory": {
      "type": "string",
      "pattern": "^proposals/batch-issue-[1-9][0-9]*$"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "registry_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "invalid_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/invalidRow" }
    },
    "organizations": {
      "type": "array",
      "items": { "$ref": "#/$defs/organizationOption" }
    }
  },
  "$defs": {
    "nullableText": { "type": ["string", "null"], "maxLength": 10000 },
    "submittedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["university", "school", "department"],
      "properties": {
        "university": { "$ref": "#/$defs/nullableText" },
        "school": { "$ref": "#/$defs/nullableText" },
        "department": { "$ref": "#/$defs/nullableText" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "batch_row", "name", "email", "source_url"],
      "properties": {
        "proposal_id": { "type": "string", "pattern": "^proposal_issue_[1-9][0-9]*_row_[1-9][0-9]*$" },
        "batch_row": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "email": { "type": "string", "minLength": 3, "maxLength": 255 },
        "profile_url": {
          "oneOf": [
            { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 500 },
            { "type": "null" }
          ]
        },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 500 },
        "identity": { "$ref": "#/$defs/identityCandidate" }
      }
    },
    "identityCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_resolution", "target_mentor_id", "match_status", "review_reasons", "mentor"],
      "properties": {
        "requires_resolution": { "const": true },
        "target_mentor_id": { "type": "string", "pattern": "^mentor_[a-z0-9][a-z0-9_-]{7,63}$" },
        "match_status": { "const": "conflict" },
        "review_reasons": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "pattern": "^[a-z0-9_]{2,64}$" },
          "uniqueItems": true
        },
        "mentor": { "$ref": "#/$defs/identityMentor" }
      }
    },
    "identityMentor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "email", "affiliations"],
      "properties": {
        "id": { "type": "string", "pattern": "^mentor_[a-z0-9][a-z0-9_-]{7,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "email": { "type": "string", "minLength": 3, "maxLength": 255 },
        "affiliations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identityAffiliation" }
        }
      }
    },
    "identityAffiliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "organization_id", "status", "is_primary", "title", "source_url", "observed_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^aff_[a-z0-9][a-z0-9_-]{7,63}$" },
        "organization_id": {
          "type": ["string", "null"],
          "pattern": "^org_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        "organization_label": { "type": "string", "minLength": 1, "maxLength": 800 },
        "status": { "const": "current" },
        "is_primary": { "type": "boolean" },
        "title": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 500 },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "submitted",
        "rows",
        "source_domains",
        "source_urls",
        "suggested_organization_id",
        "review_reasons"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^org_group_[a-f0-9]{16}$" },
        "submitted": { "$ref": "#/$defs/submittedPath" },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/row" } },
        "source_domains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 253 },
          "uniqueItems": true
        },
        "source_urls": {
          "type": "array",
          "items": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 500 },
          "uniqueItems": true
        },
        "suggested_organization_id": {
          "type": ["string", "null"],
          "pattern": "^org_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        "review_reasons": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_]{2,64}$" },
          "uniqueItems": true
        }
      }
    },
    "invalidRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_row", "sheet_row", "reason_code", "message", "submitted"],
      "properties": {
        "batch_row": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "sheet_row": { "type": "integer", "minimum": 2, "maximum": 5001 },
        "reason_code": { "enum": ["missing_required_fields", "invalid_row_data"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "submitted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "email", "title", "university", "school", "department", "research_direction", "recent_papers", "profile_url", "source_url"],
          "properties": {
            "name": { "type": "string", "maxLength": 10000 },
            "email": { "type": "string", "maxLength": 10000 },
            "title": { "type": "string", "maxLength": 10000 },
            "university": { "type": "string", "maxLength": 10000 },
            "school": { "type": "string", "maxLength": 10000 },
            "department": { "type": "string", "maxLength": 10000 },
            "research_direction": { "type": "string", "maxLength": 10000 },
            "recent_papers": { "type": "string", "maxLength": 10000 },
            "profile_url": { "type": "string", "maxLength": 10000 },
            "source_url": { "type": "string", "maxLength": 10000 }
          }
        }
      }
    },
    "organizationOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "canonical_name", "parent_id", "aliases", "official_urls", "approved_domains", "lineage_ids", "lineage_names"],
      "properties": {
        "id": { "type": "string", "pattern": "^org_[a-z0-9][a-z0-9_-]{2,63}$" },
        "type": { "enum": ["university", "school", "institute", "department", "center", "laboratory"] },
        "canonical_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "parent_id": { "type": ["string", "null"], "pattern": "^org_[a-z0-9][a-z0-9_-]{2,63}$" },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 255 }, "uniqueItems": true },
        "official_urls": { "type": "array", "items": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 500 }, "uniqueItems": true },
        "approved_domains": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 253 }, "uniqueItems": true },
        "lineage_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^org_[a-z0-9][a-z0-9_-]{2,63}$" } },
        "lineage_names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 255 } }
      }
    }
  }
}
