{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoemailsender.example/schemas/manifest.schema.json",
  "title": "MentorData published dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "generated_at",
    "minimum_app_version",
    "files"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "dataset_version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}Z-[a-f0-9]{12}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "minimum_app_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^(catalog|revocations|data/[a-z0-9_-]+/[a-z0-9_-]+)\\.json$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}

